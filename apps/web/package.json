{
  "name": "web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm build:manifest && vite",
    "build:manifest": "tsx scripts/build-manifest.ts",
    "build": "pnpm build:manifest && tsc --noEmit && vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "gen:api": "cd ../api && uv run python -m woodshed_api.export_openapi > ../web/src/api/openapi.json && cd ../web && openapi-typescript src/api/openapi.json -o src/api/schema.d.ts",
    "check": "pnpm build:manifest && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.4.0",
    "tone": "^15.1.22",
    "vexflow": "^5.0.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@mdx-js/rollup": "^3.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fast-check": "^4.10.2",
    "openapi-typescript": "^7.13.0",
    "remark-frontmatter": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
