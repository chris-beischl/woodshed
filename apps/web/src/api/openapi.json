{
  "openapi": "3.1.0",
  "info": {
    "title": "woodshed API",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/plan": {
      "get": {
        "summary": "Get Plan",
        "operationId": "get_plan_plan_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "now",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Now"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlanOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/reviews": {
      "post": {
        "summary": "Post Review",
        "operationId": "post_review_reviews_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "now",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Now"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReviewIn"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/cards": {
      "get": {
        "summary": "List Cards",
        "operationId": "list_cards_cards_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "template_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Template Id"
            }
          },
          {
            "name": "key",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Key"
            }
          },
          {
            "name": "state",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "new",
                    "learning",
                    "review",
                    "relearning"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "State"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CardOut"
                  },
                  "title": "Response List Cards Cards Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/cards/{card_id}": {
      "patch": {
        "summary": "Patch Card",
        "operationId": "patch_card_cards__card_id__patch",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "card_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Card Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CardPatch"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CardOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/lessons/{lesson_id}/complete": {
      "post": {
        "summary": "Complete Lesson",
        "operationId": "complete_lesson_lessons__lesson_id__complete_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "lesson_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Lesson Id"
            }
          },
          {
            "name": "now",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Now"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LessonCompleteOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/progress": {
      "get": {
        "summary": "Get Progress",
        "operationId": "get_progress_progress_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProgressOut"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/settings": {
      "get": {
        "summary": "Read Settings",
        "operationId": "read_settings_settings_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettingsModel"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      },
      "put": {
        "summary": "Update Settings",
        "operationId": "update_settings_settings_put",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SettingsModel"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettingsModel"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "CardCounts": {
        "properties": {
          "new": {
            "type": "integer",
            "title": "New",
            "default": 0
          },
          "learning": {
            "type": "integer",
            "title": "Learning",
            "default": 0
          },
          "review": {
            "type": "integer",
            "title": "Review",
            "default": 0
          },
          "relearning": {
            "type": "integer",
            "title": "Relearning",
            "default": 0
          }
        },
        "type": "object",
        "title": "CardCounts"
      },
      "CardOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "template_id": {
            "type": "string",
            "title": "Template Id"
          },
          "key": {
            "type": "string",
            "title": "Key"
          },
          "variant": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Variant"
          },
          "state": {
            "type": "string",
            "enum": [
              "new",
              "learning",
              "review",
              "relearning"
            ],
            "title": "State"
          },
          "due": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Due"
          },
          "suspended": {
            "type": "boolean",
            "title": "Suspended"
          },
          "introduced_at": {
            "type": "string",
            "format": "date-time",
            "title": "Introduced At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "template_id",
          "key",
          "variant",
          "state",
          "due",
          "suspended",
          "introduced_at"
        ],
        "title": "CardOut"
      },
      "CardPatch": {
        "properties": {
          "suspended": {
            "type": "boolean",
            "title": "Suspended"
          }
        },
        "type": "object",
        "required": [
          "suspended"
        ],
        "title": "CardPatch"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status",
            "default": "ok"
          }
        },
        "type": "object",
        "title": "Health"
      },
      "KeyStats": {
        "properties": {
          "cards": {
            "type": "integer",
            "title": "Cards"
          },
          "reviews": {
            "type": "integer",
            "title": "Reviews"
          },
          "again_rate": {
            "type": "number",
            "title": "Again Rate"
          }
        },
        "type": "object",
        "required": [
          "cards",
          "reviews",
          "again_rate"
        ],
        "title": "KeyStats"
      },
      "LessonCompleteOut": {
        "properties": {
          "lesson_id": {
            "type": "string",
            "title": "Lesson Id"
          },
          "cards_created": {
            "type": "integer",
            "title": "Cards Created"
          }
        },
        "type": "object",
        "required": [
          "lesson_id",
          "cards_created"
        ],
        "title": "LessonCompleteOut"
      },
      "NextLessonOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "estimated_minutes": {
            "type": "number",
            "title": "Estimated Minutes"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "estimated_minutes"
        ],
        "title": "NextLessonOut"
      },
      "PlanItemOut": {
        "properties": {
          "card_id": {
            "type": "string",
            "title": "Card Id"
          },
          "template_id": {
            "type": "string",
            "title": "Template Id"
          },
          "key": {
            "type": "string",
            "title": "Key"
          },
          "estimated_seconds": {
            "type": "number",
            "title": "Estimated Seconds"
          },
          "is_new": {
            "type": "boolean",
            "title": "Is New"
          }
        },
        "type": "object",
        "required": [
          "card_id",
          "template_id",
          "key",
          "estimated_seconds",
          "is_new"
        ],
        "title": "PlanItemOut"
      },
      "PlanOut": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/PlanItemOut"
            },
            "type": "array",
            "title": "Items"
          },
          "next_lesson": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/NextLessonOut"
              },
              {
                "type": "null"
              }
            ]
          },
          "overflow": {
            "type": "integer",
            "title": "Overflow"
          },
          "remaining_seconds": {
            "type": "number",
            "title": "Remaining Seconds"
          },
          "content_version": {
            "type": "string",
            "title": "Content Version"
          }
        },
        "type": "object",
        "required": [
          "items",
          "next_lesson",
          "overflow",
          "remaining_seconds",
          "content_version"
        ],
        "title": "PlanOut"
      },
      "ProgressOut": {
        "properties": {
          "completed_lessons": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Completed Lessons"
          },
          "card_counts": {
            "$ref": "#/components/schemas/CardCounts"
          },
          "per_key": {
            "additionalProperties": {
              "$ref": "#/components/schemas/KeyStats"
            },
            "type": "object",
            "title": "Per Key"
          }
        },
        "type": "object",
        "required": [
          "completed_lessons",
          "card_counts",
          "per_key"
        ],
        "title": "ProgressOut"
      },
      "ReviewIn": {
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "title": "Id",
            "description": "Client-generated UUID (idempotency key)"
          },
          "card_id": {
            "type": "string",
            "title": "Card Id"
          },
          "rating": {
            "type": "string",
            "enum": [
              "again",
              "hard",
              "good",
              "easy"
            ],
            "title": "Rating"
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Duration Ms"
          },
          "attempts": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Attempts"
          },
          "details": {
            "additionalProperties": true,
            "type": "object",
            "title": "Details"
          },
          "source": {
            "type": "string",
            "enum": [
              "review",
              "lesson"
            ],
            "title": "Source"
          }
        },
        "type": "object",
        "required": [
          "id",
          "card_id",
          "rating",
          "duration_ms",
          "attempts",
          "source"
        ],
        "title": "ReviewIn"
      },
      "ReviewOut": {
        "properties": {
          "card_id": {
            "type": "string",
            "title": "Card Id"
          },
          "state": {
            "type": "string",
            "enum": [
              "new",
              "learning",
              "review",
              "relearning"
            ],
            "title": "State"
          },
          "due": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Due"
          }
        },
        "type": "object",
        "required": [
          "card_id",
          "state",
          "due"
        ],
        "title": "ReviewOut"
      },
      "SettingsModel": {
        "properties": {
          "daily_minutes": {
            "type": "integer",
            "maximum": 1440.0,
            "minimum": 1.0,
            "title": "Daily Minutes",
            "default": 30
          },
          "new_card_ratio": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "New Card Ratio",
            "default": 0.2
          },
          "desired_retention": {
            "type": "number",
            "maximum": 0.99,
            "minimum": 0.7,
            "title": "Desired Retention",
            "default": 0.9
          },
          "timezone": {
            "type": "string",
            "title": "Timezone",
            "default": "Europe/Berlin"
          },
          "day_rollover_hour": {
            "type": "integer",
            "maximum": 23.0,
            "minimum": 0.0,
            "title": "Day Rollover Hour",
            "default": 4
          },
          "new_cards_per_day": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "New Cards Per Day",
            "default": 10
          },
          "keys_in_progress": {
            "type": "integer",
            "maximum": 12.0,
            "minimum": 1.0,
            "title": "Keys In Progress",
            "default": 4
          }
        },
        "type": "object",
        "title": "SettingsModel"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
